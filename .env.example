# Claude API key. Used for extraction, the view agent and the evals.
ANTHROPIC_API_KEY=

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001

# Postgres (docker compose up -d gives you this one).
# Leave it empty to run on an in-memory store that seeds itself on start.
DATABASE_URL=postgres://intake:intake@localhost:5433/intake_desk

# Signs the demo session cookie. Use a long random string anywhere but your laptop.
SESSION_SECRET=change-me-to-a-long-random-string

# "Today" for date checks, and how times are shown
APP_TIMEZONE=America/New_York

# Only for npm test: a throwaway database the Postgres tests may wipe. Never your dev DB.
# TEST_DATABASE_URL=postgres://intake:intake@localhost:5433/intake_desk_test